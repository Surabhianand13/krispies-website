# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Security ──────────────────────────────────────────────────────────────────
# Change JWT_SECRET to a long random string before deploying to production!
JWT_SECRET=change_this_to_a_long_random_string_before_going_live
JWT_EXPIRES_IN=8h
# Customer "My Account" login sessions -- separate from the admin expiry
# above since the token sits in localStorage for a "stay logged in" UX.
CUSTOMER_JWT_EXPIRES_IN=7d

# ── Admin credentials ─────────────────────────────────────────────────────────
# Password for the admin panel login -- only used to seed the admin account
# the very first time the users table is empty; ignored afterward. Pick a
# strong, unique value. If left unset, a random one is generated and printed
# once to the server logs on first boot (see backend/db/database.js).
ADMIN_PASSWORD=choose_a_strong_unique_password

# ── Email ─────────────────────────────────────────────────────────────────────
# Your business email — notifications are sent TO this address
ADMIN_EMAIL=your@email.com

# Gmail account that SENDS the notifications
# Use a Gmail App Password (not your regular Gmail password):
#   Gmail → Settings → Security → 2-Step Verification ON → App Passwords → Generate
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
# Change to your actual domain when deploying (e.g. https://krispies.in)
FRONTEND_URL=http://localhost:3737

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get these from: razorpay.com → Settings → API Keys
# Key ID is semi-public (sent to frontend SDK). Key Secret is strictly server-only.
# NEVER commit actual values — set these in Render → Environment instead.
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Meta Conversions API ──────────────────────────────────────────────────────
# Create a Pixel at business.facebook.com/events_manager2 → Connect Data
# Sources → Web → Meta Pixel. The Pixel ID also needs pasting into
# js/main.js (META_PIXEL_ID constant) for the client-side Pixel to load.
# Generate the access token from: Events Manager → your Pixel → Settings →
# Conversions API → Generate access token. Strictly server-only — never
# commit the actual value, set it in Render → Environment instead.
META_PIXEL_ID=your_pixel_id_here
META_CAPI_ACCESS_TOKEN=your_conversions_api_access_token_here
