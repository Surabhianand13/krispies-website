# Cloudflare Pages headers configuration
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers, site-wide. Most important for /admin/* (login + JWT-
# protected panel) but applied everywhere since the storefront also handles
# checkout/payment. X-Frame-Options: DENY stops the admin login or checkout
# flow from being embedded in a clickjacking iframe on another site.
# geolocation is allowed for self only -- checkout's "detect my location"
# delivery-fee feature needs it.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self)

# Always revalidate banner & hero images so new uploads reflect instantly
/assets/images/hero-*.jpg
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/banner-*.jpg
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/qcat-*.jpg
  Cache-Control: public, max-age=0, must-revalidate

/assets/videos/*
  Cache-Control: public, max-age=0, must-revalidate

# Always revalidate HTML files so layout changes show up immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Long-cache other static assets (they have content hashes / rarely change)
/assets/images/*
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/assets/images/hero/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/banners/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/products/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/categories/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/subcategories/*
  Cache-Control: public, max-age=0, must-revalidate
